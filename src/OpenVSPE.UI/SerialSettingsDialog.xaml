<Window x:Class="OpenVSPE.UI.SerialSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial port settings" Height="360" Width="380" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tabela de configuracoes (estilo VSPE) -->
        <Border Grid.Row="0" BorderBrush="#999" BorderThickness="1" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Speed -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Speed" Padding="8,6" Background="#F8F8F8"/>
                <ComboBox x:Name="cmbSpeed" Grid.Row="0" Grid.Column="1" Margin="4,4" IsEditable="True">
                    <ComboBoxItem Content="1200"/>
                    <ComboBoxItem Content="2400"/>
                    <ComboBoxItem Content="4800"/>
                    <ComboBoxItem Content="9600" IsSelected="True"/>
                    <ComboBoxItem Content="19200"/>
                    <ComboBoxItem Content="38400"/>
                    <ComboBoxItem Content="57600"/>
                    <ComboBoxItem Content="115200"/>
                </ComboBox>

                <!-- DTR/RTS -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="DTR/RTS" Padding="8,6"/>
                <ComboBox x:Name="cmbDtrRts" Grid.Row="1" Grid.Column="1" Margin="4,4">
                    <ComboBoxItem Content="NO" IsSelected="True"/>
                    <ComboBoxItem Content="YES"/>
                </ComboBox>

                <!-- Parity -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Parity" Padding="8,6" Background="#F8F8F8"/>
                <ComboBox x:Name="cmbParity" Grid.Row="2" Grid.Column="1" Margin="4,4">
                    <ComboBoxItem Content="no" IsSelected="True"/>
                    <ComboBoxItem Content="odd"/>
                    <ComboBoxItem Content="even"/>
                    <ComboBoxItem Content="mark"/>
                    <ComboBoxItem Content="space"/>
                </ComboBox>

                <!-- Bits -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Bits" Padding="8,6"/>
                <ComboBox x:Name="cmbBits" Grid.Row="3" Grid.Column="1" Margin="4,4">
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8" IsSelected="True"/>
                </ComboBox>

                <!-- Stop bits -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Stop bits" Padding="8,6" Background="#F8F8F8"/>
                <ComboBox x:Name="cmbStopBits" Grid.Row="4" Grid.Column="1" Margin="4,4">
                    <ComboBoxItem Content="1" IsSelected="True"/>
                    <ComboBoxItem Content="1.5"/>
                    <ComboBoxItem Content="2"/>
                </ComboBox>

                <!-- ReadIntervalTimeout -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="ReadIntervalTimeout" Padding="8,6"/>
                <TextBox x:Name="txtReadTimeout" Grid.Row="5" Grid.Column="1" Text="100" Margin="4,4" Padding="4,2"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Botoes -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Padding="4,6" Margin="0,0,8,0" Click="btnOk_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Padding="4,6" Click="btnCancelar_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
