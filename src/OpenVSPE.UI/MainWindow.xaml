<Window x:Class="OpenVSPE.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenVSPE v1.1.9" 
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <!-- LAYOUT PRINCIPAL -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <ToolBar Grid.Row="0" Background="#E8E8E8">
            <Button x:Name="btnNovo" ToolTip="Novo Canal" Click="btnNovo_Click" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=" Novo" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button x:Name="btnIniciar" ToolTip="Iniciar Todos" Click="btnIniciarTodos_Click" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="Green" VerticalAlignment="Center"/>
                    <TextBlock Text=" Iniciar" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnParar" ToolTip="Parar Todos" Click="btnPararTodos_Click" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="Red" VerticalAlignment="Center"/>
                    <TextBlock Text=" Parar" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button x:Name="btnEditar" ToolTip="Editar Canal Selecionado" Click="btnEditar_Click" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=" Editar" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnRemover" ToolTip="Remover Canal Selecionado" Click="btnRemover_Click" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="Red" VerticalAlignment="Center"/>
                    <TextBlock Text=" Remover" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button x:Name="btnTestar" ToolTip="Testar Impress�o" Click="btnTestar_Click" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="Teal" VerticalAlignment="Center"/>
                    <TextBlock Text=" Testar" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button x:Name="btnReparar" ToolTip="Reparar Balanca (Reset Hardware)" Click="btnReparar_Click" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FF8C00" VerticalAlignment="Center"/>
                    <TextBlock Text=" Reparar Balanca" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button x:Name="btnLogs" ToolTip="Abrir Pasta de Logs" Click="btnLogs_Click" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=" Logs" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button x:Name="btnSalvar" ToolTip="Salvar Configuracao" Click="btnSalvar_Click" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=" Salvar" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- LISTA DE CANAIS (estilo VSPE) -->
        <ListView x:Name="lstCanais" Grid.Row="1" Margin="4" SelectionMode="Single"
                   MouseDoubleClick="lstCanais_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Titulo" Width="250" DisplayMemberBinding="{Binding Titulo}"/>
                    <GridViewColumn Header="Tipo" Width="120" DisplayMemberBinding="{Binding Tipo}"/>
                        <GridViewColumn Header="Status" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding ColorStatus}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    <GridViewColumn Header="Conexoes" Width="80" DisplayMemberBinding="{Binding Conexoes}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- SEPARADOR -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#D0D0D0"/>

        <!-- LOG (estilo VSPE) -->
        <TextBox x:Name="txtLog" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                 Background="White" Foreground="#333" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto" Margin="4" BorderBrush="#CCC"/>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="4" Background="#E0E0E0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="statusDot" Width="8" Height="8" Fill="Gray" Margin="0,0,6,0"/>
                    <TextBlock x:Name="txtStatus" Text="Pronto" FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Desenvolvido por Vinicius Mazaroski" FontSize="11" Foreground="#888" Margin="0,0,10,0" FontStyle="Italic"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="txtIpLocal" Text="" FontSize="11" Foreground="#666"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
